node_modules/
Thumbs.db
desktop.ini
.DS_Store
/projects/

# 浏览器兜底通道上传的视频副本(/api/upload-video 存放处)
/videos/

# 发行版产物: 只发安装包(SubFabric-<版本>-setup.exe), 不再出便携版 zip
K-ASS-Editor-*.zip
K-ASS-Editor-*/
SubFabric-*.zip
SubFabric-*/

# SEA 构建产物(build_exe.py 生成: node.exe 副本 175MB + blob + 注入后的 exe)
/build/


# Python 字节码
__pycache__/

# 服务端诊断快照(/api/diag 由前端上报时写, 不入库)
.diag.json

# 下载内核自举的 yt-dlp（首次使用时从 PyPI 下到 asr/ytdlp/, 约 3MB, 不入库）
asr/ytdlp/

# 下载内核自举日志（ytdlp.ensure() 写的 bootstrap.log）
asr/logs/
