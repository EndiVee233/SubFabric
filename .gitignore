.workbuddy/
.workbuddy-ai/

# main.py 首次运行会在脚本目录写一份本地设置(字体字号等), 不入库
config.json

# 语音识别(创建初稿): Python 环境 / 模型本体(631MB) / 模型目录配置 都在本地生成
asr/.venv/
asr/models/
asr/settings.json
asr/__pycache__/

# whisper.cpp 运行时二进制(约 77MB): 不入库, 首次使用时由服务端自动下载
# (zips→解压→展平到 asr/whisper.cpp/, 见 server.js startRuntimeDownload)
asr/whisper.cpp/

# 一键安装的内置 Python(Embeddable, 约 60MB): 不入库, 设置里点「一键安装」时下载
asr/runtime-python/

# 本地联调用的视频素材(12 秒英文语音, 供端到端测试)
/_test/

