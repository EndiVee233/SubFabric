{
  "name": "subfabric-desktop",
  "productName": "SubFabric",
  "version": "1.5.2-beta.1",
  "description": "SubFabric local subtitle editor — Electron desktop edition",
  "author": "EndiVee233",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "stage": "node stage.mjs",
    "dist:win": "node build.mjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.endivee233.subfabric",
    "asar": true,
    "directories": { "output": "../build/electron", "buildResources": "../build/installer" },
    "files": ["main.cjs", "backend.cjs", "security.cjs", "package.json"],
    "win": {
      "icon": "../build/installer/logo.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "SubFabric-1.5.2.1-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SubFabric",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
